{
  "name": "@kaluch/db",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.json",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "generate": "prisma generate",
    "migrate:dev": "dotenv -e ../../.env -- prisma migrate dev",
    "migrate:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "reset": "dotenv -e ../../.env -- prisma migrate reset --force --skip-seed && pnpm seed",
    "seed": "dotenv -e ../../.env -- tsx src/seed/demo.ts",
    "seed:base": "dotenv -e ../../.env -- tsx src/seed/base.ts",
    "test": "dotenv -e ../../.env -- vitest run"
  },
  "dependencies": {
    "@kaluch/shared": "workspace:*",
    "@prisma/client": "6.19.3",
    "argon2": "0.44.0",
    "decimal.js": "10.6.0",
    "prisma": "6.19.3"
  },
  "devDependencies": {
    "tsx": "4.20.6",
    "dotenv-cli": "10.0.0",
    "vitest": "3.2.4",
    "@types/node": "22.18.8",
    "fast-check": "4.10.2"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "typesVersions": {
    "*": {
      "testing": [
        "dist/testing.d.ts"
      ]
    }
  }
}
