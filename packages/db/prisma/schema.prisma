// Esquema núcleo (fase 1). Ver docs/02-modelo-datos.md.
// Las reglas que Prisma no expresa (cuadre diferido, inmutabilidad, periodos,
// saldos materializados, auditoría) están en migraciones SQL de esta misma carpeta.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────── Organización ─────────────────────────

enum CompanyKind {
  LEGAL
  PARTNER_POOL
}

model Company {
  id           String      @id @default(uuid(7)) @db.Uuid
  code         String      @unique
  legalName    String      @map("legal_name")
  section      String
  country      String?     @db.Char(2)
  kind         CompanyKind @default(LEGAL)
  consolidates Boolean     @default(true)
  active       Boolean     @default(true)
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  periods          FiscalPeriod[]
  entries          JournalEntry[]
  userRoles        UserCompanyRole[]
  treasuryAccounts TreasuryAccount[]
  documents        Document[]
  partyAccounts    PartyAccount[]
  exportInvoices   ExportInvoice[]
  containers       Container[]
  loans            Loan[]
  yearCloses       YearClose[]

  @@map("company")
}

model Segment {
  id       String    @id @default(uuid(7)) @db.Uuid
  code     String    @unique
  name     String
  parentId String?   @map("parent_id") @db.Uuid
  parent   Segment?  @relation("SegmentTree", fields: [parentId], references: [id])
  children Segment[] @relation("SegmentTree")
  active   Boolean   @default(true)

  dimensionValues DimensionValue[]

  @@map("segment")
}

enum Dimension {
  CONTAINER
  PROJECT
  POS
  WAREHOUSE
}

model DimensionValue {
  id        String    @id @default(uuid(7)) @db.Uuid
  dimension Dimension
  code      String
  name      String
  segmentId String?   @map("segment_id") @db.Uuid
  segment   Segment?  @relation(fields: [segmentId], references: [id])
  companyId String?   @map("company_id") @db.Uuid
  active    Boolean   @default(true)

  @@unique([dimension, code])
  @@map("dimension_value")
}

// ───────────────────────── Monedas y tasas ─────────────────────────

model Currency {
  code     String  @id @db.VarChar(3)
  name     String
  decimals Int     @default(2)
  active   Boolean @default(true)

  @@map("currency")
}

model RateType {
  code String @id @db.VarChar(8)
  name String

  @@map("rate_type")
}

/// Convención: 1 base (USD salvo CUP/EUR) = rate unidades de `currency`.
model ExchangeRate {
  id        String   @id @default(uuid(7)) @db.Uuid
  rateDate  DateTime @map("rate_date") @db.Date
  currency  String   @db.VarChar(3)
  rateType  String   @map("rate_type") @db.VarChar(8)
  base      String   @default("USD") @db.VarChar(3)
  rate      Decimal  @db.Decimal(20, 10)
  source    String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  createdBy String?  @map("created_by") @db.Uuid

  @@unique([rateDate, currency, rateType, base])
  @@index([currency, rateType, rateDate(sort: Desc)])
  @@map("exchange_rate")
}

// ───────────────────────── Plan de cuentas ─────────────────────────

enum Nature {
  DEUDORA
  ACREEDORA
  MIXTA
}

enum Classification {
  AC
  PC
  CC
  CND
  CNA
}

model Account {
  id               String         @id @default(uuid(7)) @db.Uuid
  parentId         String?        @map("parent_id") @db.Uuid
  parent           Account?       @relation("AccountTree", fields: [parentId], references: [id])
  children         Account[]      @relation("AccountTree")
  code             String
  subcode          String?
  /// Código único interno ("101.0001"; duplicados del Excel llevan sufijo "#2").
  fullCode         String         @unique @map("full_code")
  /// Código tal como aparece en el Excel/UI.
  displayCode      String         @map("display_code")
  name             String
  nature           Nature
  classification   Classification
  postable         Boolean
  currencyLock     String?        @map("currency_lock") @db.VarChar(3)
  revalRateType    String?        @map("reval_rate_type") @db.VarChar(8)
  revalCurrency    String?        @map("reval_currency") @db.VarChar(3)
  requiresParty    Boolean        @default(false) @map("requires_party")
  isIntercompany   Boolean        @default(false) @map("is_intercompany")
  isPendingExport  Boolean        @default(false) @map("is_pending_export")
  defaultSegmentId String?        @map("default_segment_id") @db.Uuid
  /// Anomalía detectada al migrar (duplicado, naturaleza incoherente…).
  anomaly          String?
  sortOrder        Int            @default(0) @map("sort_order")
  active           Boolean        @default(true)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  lines            JournalLine[]
  mappings         AccountMapping[]
  treasuryAccounts TreasuryAccount[]
  categories       CashCategory[]
  partyMain        PartyAccount[]    @relation("PartyMainAccount")
  partyOpposite    PartyAccount[]    @relation("PartyOppositeAccount")

  @@index([parentId])
  @@index([code])
  @@map("account")
}

/// Resolución de cuentas para reglas de contabilización (de lo específico a lo general).
model AccountMapping {
  id        String   @id @default(uuid(7)) @db.Uuid
  key       String
  companyId String?  @map("company_id") @db.Uuid
  segmentId String?  @map("segment_id") @db.Uuid
  currency  String?  @db.VarChar(3)
  accountId String   @map("account_id") @db.Uuid
  account   Account  @relation(fields: [accountId], references: [id])
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([key])
  @@map("account_mapping")
}

// ───────────────────────── Libro mayor ─────────────────────────

enum PeriodStatus {
  OPEN
  SOFT_CLOSED
  LOCKED
}

model FiscalPeriod {
  id        String       @id @default(uuid(7)) @db.Uuid
  companyId String       @map("company_id") @db.Uuid
  company   Company      @relation(fields: [companyId], references: [id])
  year      Int
  month     Int
  status    PeriodStatus @default(OPEN)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  entries JournalEntry[]

  @@unique([companyId, year, month])
  @@map("fiscal_period")
}

enum Book {
  BASE
  REAL
  FISCAL
}

enum EntryKind {
  AUTO
  MANUAL
  REVAL
  CLOSING
  OPENING
  REVERSAL
  /// Reclasificación de fin de mes de saldos por signo (se anula el día 1 del mes siguiente).
  RECLASS
}

enum EntryStatus {
  POSTED
  REVERSED
}

model JournalEntry {
  id         String        @id @default(uuid(7)) @db.Uuid
  companyId  String        @map("company_id") @db.Uuid
  company    Company       @relation(fields: [companyId], references: [id])
  periodId   String        @map("period_id") @db.Uuid
  period     FiscalPeriod  @relation(fields: [periodId], references: [id])
  number     String
  entryDate  DateTime      @map("entry_date") @db.Date
  book       Book          @default(BASE)
  kind       EntryKind
  documentId String?       @map("document_id") @db.Uuid
  reversesId String?       @unique @map("reverses_id") @db.Uuid
  reverses   JournalEntry? @relation("Reversal", fields: [reversesId], references: [id])
  reversedBy JournalEntry? @relation("Reversal")
  status     EntryStatus   @default(POSTED)
  memo       String
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz
  createdBy  String?       @map("created_by") @db.Uuid

  lines JournalLine[]

  @@unique([companyId, number])
  @@index([companyId, entryDate])
  @@map("journal_entry")
}

model JournalLine {
  id                String       @id @default(uuid(7)) @db.Uuid
  entryId           String       @map("entry_id") @db.Uuid
  entry             JournalEntry @relation(fields: [entryId], references: [id])
  lineNo            Int          @map("line_no")
  /// Desnormalizados desde journal_entry por trigger (para índices).
  companyId         String       @map("company_id") @db.Uuid
  entryDate         DateTime     @map("entry_date") @db.Date
  accountId         String       @map("account_id") @db.Uuid
  account           Account      @relation(fields: [accountId], references: [id])
  segmentId         String?      @map("segment_id") @db.Uuid
  partyId           String?      @map("party_id") @db.Uuid
  treasuryAccountId String?      @map("treasury_account_id") @db.Uuid
  containerId       String?      @map("container_id") @db.Uuid
  projectId         String?      @map("project_id") @db.Uuid
  posId             String?      @map("pos_id") @db.Uuid
  counterCompanyId  String?      @map("counter_company_id") @db.Uuid
  currency          String       @db.VarChar(3)
  /// Importe original con signo: + Debe / − Haber.
  amount            Decimal      @db.Decimal(18, 4)
  rate              Decimal      @db.Decimal(20, 10)
  rateType          String?      @map("rate_type") @db.VarChar(8)
  amountUsd         Decimal      @map("amount_usd") @db.Decimal(18, 4)
  cashFlowCategory  String?      @map("cash_flow_category")
  memo              String?

  @@unique([entryId, lineNo])
  @@index([companyId, accountId, entryDate])
  @@index([partyId, entryDate])
  @@index([containerId])
  @@index([treasuryAccountId, entryDate])
  @@map("journal_line")
}

/// Saldos materializados por periodo. Mantenidos por trigger al insertar líneas.
/// segment_key = segment_id o '00000000-…' si no hay segmento (para la PK).
model LedgerBalance {
  companyId  String  @map("company_id") @db.Uuid
  book       Book
  periodId   String  @map("period_id") @db.Uuid
  year       Int
  month      Int
  accountId  String  @map("account_id") @db.Uuid
  segmentKey String  @map("segment_key") @db.Uuid
  currency   String  @db.VarChar(3)
  debitUsd   Decimal @default(0) @map("debit_usd") @db.Decimal(18, 4)
  creditUsd  Decimal @default(0) @map("credit_usd") @db.Decimal(18, 4)
  amountOrig Decimal @default(0) @map("amount_orig") @db.Decimal(18, 4)

  @@id([companyId, book, periodId, accountId, segmentKey, currency])
  @@index([year, month])
  @@map("ledger_balance")
}

model DocumentSequence {
  companyId String @map("company_id") @db.Uuid
  year      Int
  kind      String
  lastValue Int    @default(0) @map("last_value")

  @@id([companyId, year, kind])
  @@map("document_sequence")
}

// ───────────────────────── Parámetros ─────────────────────────

model Parameter {
  key         String             @id
  description String
  versions    ParameterVersion[]

  @@map("parameter")
}

model ParameterVersion {
  id        String    @id @default(uuid(7)) @db.Uuid
  key       String
  parameter Parameter @relation(fields: [key], references: [key])
  validFrom DateTime  @map("valid_from") @db.Date
  value     Json

  @@unique([key, validFrom])
  @@map("parameter_version")
}

// ───────────────────────── Seguridad y auditoría ─────────────────────────

model AppUser {
  id           String    @id @default(uuid(7)) @db.Uuid
  email        String    @unique
  name         String
  passwordHash String    @map("password_hash")
  totpSecret   String?   @map("totp_secret")
  totpEnabled  Boolean   @default(false) @map("totp_enabled")
  active       Boolean   @default(true)
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  companyRoles UserCompanyRole[]

  @@map("app_user")
}

model Role {
  id          String            @id @default(uuid(7)) @db.Uuid
  name        String            @unique
  description String            @default("")
  system      Boolean           @default(false)
  requires2fa Boolean           @default(false) @map("requires_2fa")
  permissions RolePermission[]
  assignments UserCompanyRole[]

  @@map("role")
}

model RolePermission {
  roleId     String @map("role_id") @db.Uuid
  role       Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission String

  @@id([roleId, permission])
  @@map("role_permission")
}

model UserCompanyRole {
  userId    String  @map("user_id") @db.Uuid
  user      AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId String  @map("company_id") @db.Uuid
  company   Company @relation(fields: [companyId], references: [id])
  roleId    String  @map("role_id") @db.Uuid
  role      Role    @relation(fields: [roleId], references: [id])

  @@id([userId, companyId, roleId])
  @@map("user_company_role")
}

model AuditLog {
  id        BigInt   @id @default(autoincrement())
  tableName String   @map("table_name")
  recordId  String   @map("record_id")
  action    String
  before    Json?
  after     Json?
  userId    String?  @map("user_id") @db.Uuid
  at        DateTime @default(now()) @db.Timestamptz

  @@index([tableName, recordId])
  @@index([at])
  @@map("audit_log")
}

// ───────────────────────── Migración (ETL) ─────────────────────────

/// Valores del BC del Excel por cuenta y mes, para la conciliación de aceptación.
model BcReference {
  id        String   @id @default(uuid(7)) @db.Uuid
  importId  String   @map("import_id") @db.Uuid
  fullCode  String   @map("full_code")
  excelRow  Int      @map("excel_row")
  label     String
  year      Int
  month     Int
  valueUsd  Decimal  @map("value_usd") @db.Decimal(18, 4)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@unique([importId, excelRow, year, month])
  @@map("bc_reference")
}

model ImportBatch {
  id         String   @id @default(uuid(7)) @db.Uuid
  sourceFile String   @map("source_file")
  fileHash   String   @map("file_hash")
  tableName  String   @map("table_name")
  stats      Json
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("import_batch")
}

// ───────────────────────── Documentos (fase 2) ─────────────────────────

enum DocumentStatus {
  DRAFT
  POSTED
  VOIDED
}

/// Supertipo de todo documento fuente. Cada módulo guarda su detalle en una tabla 1:1.
model Document {
  id          String         @id @default(uuid(7)) @db.Uuid
  companyId   String         @map("company_id") @db.Uuid
  company     Company        @relation(fields: [companyId], references: [id])
  docType     String         @map("doc_type")
  number      String
  docDate     DateTime       @map("doc_date") @db.Date
  status      DocumentStatus @default(POSTED)
  memo        String
  /// Fila del Excel de la que procede (trazabilidad de la migración).
  importRowId String?        @unique @map("import_row_id") @db.Uuid
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz
  createdBy   String?        @map("created_by") @db.Uuid

  treasuryMovement TreasuryMovement?
  partyDocument    PartyDocument?
  exportIssue      ExportInvoice?      @relation("ExportInvoiceIssue")
  exportClose      ExportInvoice?      @relation("ExportInvoiceClose")
  salesInvoice     SalesInvoice?
  inventoryMoves   InventoryMovement[]
  loan             Loan?               @relation("LoanDisbursement")
  loanAccrual      LoanAccrual?        @relation("LoanAccrual")
  taxDocument      TaxDocument?
  capitalMovement  CapitalMovement?

  @@unique([companyId, number])
  @@index([companyId, docDate])
  @@map("document")
}

// ───────────────────────── Tesorería ─────────────────────────

enum TreasuryKind {
  CASH
  BANK
  WALLET
}

enum OwnerType {
  COMPANY
  PARTNER
}

/// Caja, cuenta bancaria o monedero (Tropipay, Stripe, Zelle). Una cuenta contable de detalle por cuenta de tesorería.
model TreasuryAccount {
  id           String       @id @default(uuid(7)) @db.Uuid
  companyId    String       @map("company_id") @db.Uuid
  company      Company      @relation(fields: [companyId], references: [id])
  glAccountId  String       @unique @map("gl_account_id") @db.Uuid
  glAccount    Account      @relation(fields: [glAccountId], references: [id])
  kind         TreasuryKind
  ownerType    OwnerType    @default(COMPANY) @map("owner_type")
  ownerName    String?      @map("owner_name")
  country      String?
  bank         String?
  /// Últimos 4 dígitos (= subcuenta). El número completo no se guarda en claro.
  last4        String?
  currency     String       @db.VarChar(3)
  name         String
  /// Origen en el Excel: hoja y criterios de la fórmula del BC (para la migración).
  sourceSheet  String?      @map("source_sheet")
  sourceFilter Json?        @map("source_filter")
  /// Cuenta creada en la migración para movimientos que el BC no asignaba a ninguna subcuenta.
  createdByEtl Boolean      @default(false) @map("created_by_etl")
  active       Boolean      @default(true)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz

  legs       TreasuryLeg[]
  statements BankStatement[]

  @@index([companyId])
  @@map("treasury_account")
}

enum CategoryKind {
  INCOME
  EXPENSE
  EXCHANGE
  TRANSFER
  DEBT
  OTHER
}

/// Clasificación de movimientos (sustituye a "Referencia cruzada").
model CashCategory {
  id               String        @id @default(uuid(7)) @db.Uuid
  code             String        @unique
  name             String
  kind             CategoryKind
  /// Cuenta contrapartida por defecto (null = va a la bandeja de revisión).
  accountId        String?       @map("account_id") @db.Uuid
  account          Account?      @relation(fields: [accountId], references: [id])
  segmentId        String?       @map("segment_id") @db.Uuid
  cashFlowCategory String        @default("OPER") @map("cash_flow_category")
  /// Cuenta corriente de contraparte: los movimientos se contabilizan contra ella (con la contraparte).
  partyAccountId   String?       @map("party_account_id") @db.Uuid
  partyAccount     PartyAccount? @relation(fields: [partyAccountId], references: [id])
  /// Variantes de texto del Excel que se normalizan a esta categoría.
  aliases          String[]      @default([])
  active           Boolean       @default(true)

  movements TreasuryMovement[]

  @@map("cash_category")
}

enum MovementKind {
  MOVEMENT
  EXCHANGE
  TRANSFER
  OPENING
}

/// Movimiento de tesorería: una o varias patas en cuentas de tesorería + contrapartida.
model TreasuryMovement {
  id               String        @id @db.Uuid
  document         Document      @relation(fields: [id], references: [id])
  kind             MovementKind
  categoryId       String?       @map("category_id") @db.Uuid
  category         CashCategory? @relation(fields: [categoryId], references: [id])
  counterAccountId String?       @map("counter_account_id") @db.Uuid
  segmentId        String?       @map("segment_id") @db.Uuid
  posId            String?       @map("pos_id") @db.Uuid
  description      String
  /// Texto original de "Referencia cruzada" / clasificación del Excel.
  sourceReference  String?       @map("source_reference")
  /// Contraparte (por la categoría o al reclasificar).
  partyId          String?       @map("party_id") @db.Uuid
  needsReview      Boolean       @default(false) @map("needs_review")
  reviewNote       String?       @map("review_note")
  resolvedAt       DateTime?     @map("resolved_at") @db.Timestamptz
  resolvedBy       String?       @map("resolved_by") @db.Uuid
  entryId          String?       @map("entry_id") @db.Uuid

  legs TreasuryLeg[]

  @@index([needsReview])
  @@map("treasury_movement")
}

model TreasuryLeg {
  id                String           @id @default(uuid(7)) @db.Uuid
  movementId        String           @map("movement_id") @db.Uuid
  movement          TreasuryMovement @relation(fields: [movementId], references: [id])
  treasuryAccountId String           @map("treasury_account_id") @db.Uuid
  treasuryAccount   TreasuryAccount  @relation(fields: [treasuryAccountId], references: [id])
  /// Importe con signo en la moneda de la cuenta: + entrada / − salida.
  amount            Decimal          @db.Decimal(18, 4)
  currency          String           @db.VarChar(3)
  rate              Decimal          @db.Decimal(20, 10)
  amountUsd         Decimal          @map("amount_usd") @db.Decimal(18, 4)
  valueDate         DateTime         @map("value_date") @db.Date

  statementLine BankStatementLine?

  @@index([treasuryAccountId, valueDate])
  @@map("treasury_leg")
}

// ───────────────────────── Extractos y conciliación bancaria ─────────────────────────

model BankStatement {
  id                String          @id @default(uuid(7)) @db.Uuid
  treasuryAccountId String          @map("treasury_account_id") @db.Uuid
  treasuryAccount   TreasuryAccount @relation(fields: [treasuryAccountId], references: [id])
  fileName          String          @map("file_name")
  fileHash          String          @map("file_hash")
  dateFrom          DateTime?       @map("date_from") @db.Date
  dateTo            DateTime?       @map("date_to") @db.Date
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz
  createdBy         String?         @map("created_by") @db.Uuid

  lines BankStatementLine[]

  @@map("bank_statement")
}

enum StatementLineStatus {
  UNMATCHED
  MATCHED
  IGNORED
}

model BankStatementLine {
  id                String              @id @default(uuid(7)) @db.Uuid
  statementId       String              @map("statement_id") @db.Uuid
  statement         BankStatement       @relation(fields: [statementId], references: [id])
  treasuryAccountId String              @map("treasury_account_id") @db.Uuid
  valueDate         DateTime            @map("value_date") @db.Date
  description       String
  /// + abono / − cargo, en la moneda de la cuenta.
  amount            Decimal             @db.Decimal(18, 4)
  /// Huella para no importar dos veces la misma línea.
  lineHash          String              @map("line_hash")
  status            StatementLineStatus @default(UNMATCHED)
  legId             String?             @unique @map("leg_id") @db.Uuid
  leg               TreasuryLeg?        @relation(fields: [legId], references: [id])

  @@unique([treasuryAccountId, lineHash])
  @@index([treasuryAccountId, status])
  @@map("bank_statement_line")
}

// ───────────────────────── Revaluación (tenencia) ─────────────────────────

model FxRevaluationRun {
  id        String   @id @default(uuid(7)) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  year      Int
  month     Int
  entryId   String?  @map("entry_id") @db.Uuid
  /// Corridas anteriores del mismo mes quedan anuladas (superseded).
  status    String   @default("POSTED")
  totalUsd  Decimal  @default(0) @map("total_usd") @db.Decimal(18, 4)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  createdBy String?  @map("created_by") @db.Uuid

  lines FxRevaluationLine[]

  @@index([companyId, year, month])
  @@map("fx_revaluation_run")
}

model FxRevaluationLine {
  id          String           @id @default(uuid(7)) @db.Uuid
  runId       String           @map("run_id") @db.Uuid
  run         FxRevaluationRun @relation(fields: [runId], references: [id])
  accountId   String           @map("account_id") @db.Uuid
  currency    String           @db.VarChar(3)
  rateType    String           @map("rate_type")
  balanceOrig Decimal          @map("balance_orig") @db.Decimal(18, 4)
  bookedUsd   Decimal          @map("booked_usd") @db.Decimal(18, 4)
  closingRate Decimal          @map("closing_rate") @db.Decimal(20, 10)
  revaluedUsd Decimal          @map("revalued_usd") @db.Decimal(18, 4)
  diffUsd     Decimal          @map("diff_usd") @db.Decimal(18, 4)

  @@map("fx_revaluation_line")
}

// ───────────────────────── Migración: filas y conciliación ─────────────────────────

enum ImportRowStatus {
  OK
  REVIEW
  SKIPPED
  ERROR
}

model ImportRow {
  id       String          @id @default(uuid(7)) @db.Uuid
  batchId  String          @map("batch_id") @db.Uuid
  sheet    String
  excelRow Int             @map("excel_row")
  raw      Json
  status   ImportRowStatus
  message  String?

  @@unique([sheet, excelRow, batchId])
  @@index([status])
  @@map("import_row")
}

/// Diferencias con el BC del Excel aceptadas con su explicación (requieren visto bueno).
model BcExplanation {
  id        String   @id @default(uuid(7)) @db.Uuid
  fullCode  String   @map("full_code")
  /// null = aplica a todos los meses.
  year      Int?
  month     Int?
  reason    String
  approved  Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([fullCode])
  @@map("bc_explanation")
}

// ───────────────────────── Contrapartes (fase 3) ─────────────────────────

enum PartyKind {
  PERSON
  COMPANY
}

enum PartyRole {
  CUSTOMER
  SUPPLIER
  EMPLOYEE
  PARTNER
  INVESTOR
  SELLER
  COURIER
  LENDER
  OTHER
}

/// Persona o empresa con la que se tienen deudas o créditos (cliente, proveedor, trabajador, socio…).
model Party {
  id        String      @id @default(uuid(7)) @db.Uuid
  code      String      @unique
  name      String
  kind      PartyKind   @default(PERSON)
  roles     PartyRole[] @default([])
  taxId     String?     @map("tax_id")
  email     String?
  phone     String?
  notes     String?
  active    Boolean     @default(true)
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz

  accounts         PartyAccount[]
  openItems        OpenItem[]
  capitalMovements CapitalMovement[]

  @@map("party")
}

/// Cuenta corriente de una contraparte en una empresa y moneda. Se contabiliza en `accountId`;
/// si tiene `oppositeAccountId`, al cierre de mes el saldo de signo contrario a la naturaleza de
/// la cuenta se reclasifica a la opuesta (p. ej. 135.x por cobrar ↔ 405.x por pagar), como el BC.
model PartyAccount {
  id                String   @id @default(uuid(7)) @db.Uuid
  companyId         String   @map("company_id") @db.Uuid
  company           Company  @relation(fields: [companyId], references: [id])
  partyId           String   @map("party_id") @db.Uuid
  party             Party    @relation(fields: [partyId], references: [id])
  currency          String   @db.VarChar(3)
  accountId         String   @map("account_id") @db.Uuid
  account           Account  @relation("PartyMainAccount", fields: [accountId], references: [id])
  oppositeAccountId String?  @map("opposite_account_id") @db.Uuid
  oppositeAccount   Account? @relation("PartyOppositeAccount", fields: [oppositeAccountId], references: [id])
  name              String
  /// Origen en el Excel (hoja y términos de la fórmula del BC) para la migración.
  sourceSheet       String?  @map("source_sheet")
  sourceFilter      Json?    @map("source_filter")
  active            Boolean  @default(true)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz

  documents          PartyDocument[]
  openItems          OpenItem[]
  categories         CashCategory[]
  exportInvoices     ExportInvoice[]     @relation("ExportInvoiceCustomer")
  exportCommissions  ExportInvoice[]     @relation("ExportInvoiceSeller")
  containerInvestors ContainerInvestor[]
  salesInvoices      SalesInvoice[]
  salesCommissions   SalesLine[]         @relation("SalesLineSeller")
  loans              Loan[]

  @@unique([companyId, partyId, currency, accountId])
  @@index([partyId])
  @@map("party_account")
}

enum PartyDocKind {
  /// Aumenta lo que la contraparte nos debe (o reduce lo que le debemos): Debe en su cuenta.
  CHARGE
  /// Aumenta lo que le debemos (o reduce lo que nos debe): Haber en su cuenta.
  CREDIT
  /// Cesión de deuda de una contraparte a otra.
  ASSIGNMENT
  OPENING
  PAYROLL
}

/// Documento de contraparte: cargo, abono, cesión, nómina o saldo de apertura.
model PartyDocument {
  id               String       @id @db.Uuid
  document         Document     @relation(fields: [id], references: [id])
  partyAccountId   String       @map("party_account_id") @db.Uuid
  partyAccount     PartyAccount @relation(fields: [partyAccountId], references: [id])
  kind             PartyDocKind
  /// Importe con signo en la moneda de la cuenta corriente: + Debe (nos deben más) / − Haber.
  amount           Decimal      @db.Decimal(18, 4)
  currency         String       @db.VarChar(3)
  rate             Decimal      @db.Decimal(20, 10)
  amountUsd        Decimal      @map("amount_usd") @db.Decimal(18, 4)
  counterAccountId String?      @map("counter_account_id") @db.Uuid
  reference        String?
  dueDate          DateTime?    @map("due_date") @db.Date
  description      String
  entryId          String?      @map("entry_id") @db.Uuid

  payroll PayrollLine?

  @@index([partyAccountId])
  @@index([reference])
  @@map("party_document")
}

enum OpenItemSide {
  RECEIVABLE
  PAYABLE
}

enum OpenItemStatus {
  OPEN
  PARTIAL
  SETTLED
  CANCELLED
}

/// Partida abierta: factura, deuda o nómina pendiente, que se liquida con uno o varios pagos.
model OpenItem {
  id             String         @id @default(uuid(7)) @db.Uuid
  companyId      String         @map("company_id") @db.Uuid
  partyId        String         @map("party_id") @db.Uuid
  party          Party          @relation(fields: [partyId], references: [id])
  partyAccountId String         @map("party_account_id") @db.Uuid
  partyAccount   PartyAccount   @relation(fields: [partyAccountId], references: [id])
  /// Documento que la origina (cargo/abono/nómina).
  documentId     String         @map("document_id") @db.Uuid
  side           OpenItemSide
  reference      String
  docDate        DateTime       @map("doc_date") @db.Date
  dueDate        DateTime?      @map("due_date") @db.Date
  currency       String         @db.VarChar(3)
  /// Importe positivo en la moneda de la partida.
  amount         Decimal        @db.Decimal(18, 4)
  amountUsd      Decimal        @map("amount_usd") @db.Decimal(18, 4)
  /// Pendiente (materializado; se actualiza con cada liquidación).
  openAmount     Decimal        @map("open_amount") @db.Decimal(18, 4)
  status         OpenItemStatus @default(OPEN)
  description    String

  settlements Settlement[]

  @@index([documentId])
  @@index([partyId, status])
  @@index([companyId, side, status])
  @@index([reference])
  @@map("open_item")
}

enum SettlementKind {
  PAYMENT
  WRITE_OFF
}

/// Aplicación de un pago (movimiento de tesorería o documento de contraparte) a una partida abierta.
/// Es un registro de casación: el pago ya está contabilizado en la cuenta de la contraparte.
/// Las diferencias de cambio de las partidas en moneda extranjera se reconocen en la revaluación
/// de fin de mes (846/925), igual que en el Excel; aquí se guardan a título informativo.
model Settlement {
  id                String         @id @default(uuid(7)) @db.Uuid
  openItemId        String         @map("open_item_id") @db.Uuid
  openItem          OpenItem       @relation(fields: [openItemId], references: [id])
  kind              SettlementKind @default(PAYMENT)
  /// Documento del pago (movimiento de tesorería o documento de contraparte).
  paymentDocumentId String?        @map("payment_document_id") @db.Uuid
  date              DateTime       @db.Date
  /// Importe aplicado, positivo, en la moneda de la partida.
  amount            Decimal        @db.Decimal(18, 4)
  usdAtBooked       Decimal        @map("usd_at_booked") @db.Decimal(18, 4)
  usdAtPayment      Decimal        @map("usd_at_payment") @db.Decimal(18, 4)
  note              String?
  voided            Boolean        @default(false)
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz
  createdBy         String?        @map("created_by") @db.Uuid

  @@index([openItemId])
  @@index([paymentDocumentId])
  @@map("settlement")
}

/// Detalle de nómina de un trabajador en un periodo (documento de contraparte de tipo PAYROLL).
model PayrollLine {
  id                  String        @id @db.Uuid
  partyDocument       PartyDocument @relation(fields: [id], references: [id])
  /// Mes de la nómina (AAAA-MM).
  period              String
  /// Pagador según el Excel: KALUCH, COMUNICACIÓN…
  employer            String
  concept             String
  gross               Decimal       @db.Decimal(18, 4)
  attendanceDeduction Decimal       @default(0) @map("attendance_deduction") @db.Decimal(18, 4)
  mipymeDeduction     Decimal       @default(0) @map("mipyme_deduction") @db.Decimal(18, 4)
  net                 Decimal       @db.Decimal(18, 4)
  currency            String        @db.VarChar(3)

  @@index([period])
  @@map("payroll_line")
}

/// Reclasificación mensual de saldos por signo (por cobrar ↔ por pagar). Repetible: anula la anterior.
model SignReclassRun {
  id              String   @id @default(uuid(7)) @db.Uuid
  companyId       String   @map("company_id") @db.Uuid
  year            Int
  month           Int
  entryId         String?  @map("entry_id") @db.Uuid
  /// Contra-asiento del día 1 del mes siguiente.
  reversalEntryId String?  @map("reversal_entry_id") @db.Uuid
  status          String   @default("POSTED")
  movedUsd        Decimal  @default(0) @map("moved_usd") @db.Decimal(18, 4)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  createdBy       String?  @map("created_by") @db.Uuid

  @@index([companyId, year, month])
  @@map("sign_reclass_run")
}

// ───────────────────────── Fase 4: exportación y distribución ─────────────────────────

enum ExportService {
  GOODS
  SERVICES
}

enum SalesDocStatus {
  PENDING
  CLOSED
  POSTED
  CANCELLED
}

/// Factura de exportación (segmento 888). Al emitirla queda pendiente (2900 / 2814–2816 contra el cliente y
/// las mercancías 180.888x); al cerrarla pasa a ventas y costos (900/901 y 814–817, o 1900/1814–1817 si el
/// cliente es interno).
model ExportInvoice {
  id                   String         @id @default(uuid(7)) @db.Uuid
  companyId            String         @map("company_id") @db.Uuid
  company              Company        @relation(fields: [companyId], references: [id])
  /// Cuenta corriente del cliente (136).
  partyAccountId       String         @map("party_account_id") @db.Uuid
  partyAccount         PartyAccount   @relation("ExportInvoiceCustomer", fields: [partyAccountId], references: [id])
  /// Vendedor que cobra comisión (410.8880).
  sellerPartyAccountId String?        @map("seller_party_account_id") @db.Uuid
  sellerPartyAccount   PartyAccount?  @relation("ExportInvoiceSeller", fields: [sellerPartyAccountId], references: [id])
  number               String
  invoiceDate          DateTime       @map("invoice_date") @db.Date
  closeDate            DateTime?      @map("close_date") @db.Date
  service              ExportService
  /// Cliente interno del grupo (MPM Grupo Roca, MPM Dmilio, Palco): ventas internas 1900 y costos 18xx.
  internal             Boolean        @default(false)
  description          String
  amountUsd            Decimal        @map("amount_usd") @db.Decimal(18, 4)
  factoryUsd           Decimal        @default(0) @map("factory_usd") @db.Decimal(18, 4)
  logisticsUsd         Decimal        @default(0) @map("logistics_usd") @db.Decimal(18, 4)
  otherUsd             Decimal        @default(0) @map("other_usd") @db.Decimal(18, 4)
  estimatedUsd         Decimal        @default(0) @map("estimated_usd") @db.Decimal(18, 4)
  commissionUsd        Decimal        @default(0) @map("commission_usd") @db.Decimal(18, 4)
  status               SalesDocStatus @default(PENDING)
  issueDocumentId      String         @unique @map("issue_document_id") @db.Uuid
  issueDocument        Document       @relation("ExportInvoiceIssue", fields: [issueDocumentId], references: [id])
  closeDocumentId      String?        @unique @map("close_document_id") @db.Uuid
  closeDocument        Document?      @relation("ExportInvoiceClose", fields: [closeDocumentId], references: [id])
  createdAt            DateTime       @default(now()) @map("created_at") @db.Timestamptz
  createdBy            String?        @map("created_by") @db.Uuid

  @@unique([companyId, number])
  @@index([status])
  @@map("export_invoice")
}

model Product {
  id        String   @id @default(uuid(7)) @db.Uuid
  code      String   @unique
  name      String
  unit      String   @default("u")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  movements InventoryMovement[]
  saleLines SalesLine[]

  @@map("product")
}

enum ContainerStatus {
  TRANSIT
  WAREHOUSE
  CLOSED
}

enum InventoryLocation {
  TRANSIT
  WAREHOUSE
}

enum InventoryMoveKind {
  COST
  RECEIPT
  SALE
  ADJUSTMENT
}

/// Contenedor de distribución (segmento 999): lote de mercancía con sus costos, inversionistas y utilidad.
model Container {
  id          String          @id @default(uuid(7)) @db.Uuid
  companyId   String          @map("company_id") @db.Uuid
  company     Company         @relation(fields: [companyId], references: [id])
  code        String
  description String          @default("")
  status      ContainerStatus @default(TRANSIT)
  arrivalDate DateTime?       @map("arrival_date") @db.Date
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz

  investors ContainerInvestor[]
  movements InventoryMovement[]
  saleLines SalesLine[]

  @@unique([companyId, code])
  @@map("container")
}

/// Participación de un inversionista en un contenedor: % del capital invertido y % de la utilidad.
model ContainerInvestor {
  id             String       @id @default(uuid(7)) @db.Uuid
  containerId    String       @map("container_id") @db.Uuid
  container      Container    @relation(fields: [containerId], references: [id])
  partyAccountId String       @map("party_account_id") @db.Uuid
  partyAccount   PartyAccount @relation(fields: [partyAccountId], references: [id])
  investedUsd    Decimal      @default(0) @map("invested_usd") @db.Decimal(18, 4)
  profitPct      Decimal      @map("profit_pct") @db.Decimal(9, 4)

  @@unique([containerId, partyAccountId])
  @@map("container_investor")
}

/// Kardex: entradas (costos y recepción), salidas por venta y ajustes, por producto, contenedor (lote) y ubicación.
/// Cantidad e importe con signo (+ entra / − sale).
model InventoryMovement {
  id          String            @id @default(uuid(7)) @db.Uuid
  companyId   String            @map("company_id") @db.Uuid
  containerId String            @map("container_id") @db.Uuid
  container   Container         @relation(fields: [containerId], references: [id])
  /// Null en los costos del contenedor aún sin repartir por producto (en tránsito).
  productId   String?           @map("product_id") @db.Uuid
  product     Product?          @relation(fields: [productId], references: [id])
  date        DateTime          @db.Date
  kind        InventoryMoveKind
  location    InventoryLocation
  quantity    Decimal           @default(0) @db.Decimal(18, 4)
  amountUsd   Decimal           @map("amount_usd") @db.Decimal(18, 4)
  description String
  documentId  String            @map("document_id") @db.Uuid
  document    Document          @relation(fields: [documentId], references: [id])
  salesLineId String?           @unique @map("sales_line_id") @db.Uuid
  salesLine   SalesLine?        @relation(fields: [salesLineId], references: [id])
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz

  @@index([containerId, productId])
  @@index([productId, date])
  @@map("inventory_movement")
}

/// Factura de venta de distribución: ingreso, costo identificado por lote, comisiones del vendedor y ONAT.
model SalesInvoice {
  id               String         @id @db.Uuid
  document         Document       @relation(fields: [id], references: [id])
  /// Cuenta corriente del cliente (137); null en ventas al contado contra la cuenta indicada.
  partyAccountId   String?        @map("party_account_id") @db.Uuid
  partyAccount     PartyAccount?  @relation(fields: [partyAccountId], references: [id])
  counterAccountId String?        @map("counter_account_id") @db.Uuid
  totalUsd         Decimal        @map("total_usd") @db.Decimal(18, 4)
  costUsd          Decimal        @map("cost_usd") @db.Decimal(18, 4)
  commissionUsd    Decimal        @map("commission_usd") @db.Decimal(18, 4)
  onatUsd          Decimal        @map("onat_usd") @db.Decimal(18, 4)
  onatRate         Decimal        @map("onat_rate") @db.Decimal(9, 6)
  status           SalesDocStatus @default(POSTED)

  lines SalesLine[]

  @@map("sales_invoice")
}

model SalesLine {
  id                   String        @id @default(uuid(7)) @db.Uuid
  invoiceId            String        @map("invoice_id") @db.Uuid
  invoice              SalesInvoice  @relation(fields: [invoiceId], references: [id])
  productId            String        @map("product_id") @db.Uuid
  product              Product       @relation(fields: [productId], references: [id])
  containerId          String        @map("container_id") @db.Uuid
  container            Container     @relation(fields: [containerId], references: [id])
  quantity             Decimal       @db.Decimal(18, 4)
  unitPriceUsd         Decimal       @map("unit_price_usd") @db.Decimal(18, 4)
  amountUsd            Decimal       @map("amount_usd") @db.Decimal(18, 4)
  costUsd              Decimal       @map("cost_usd") @db.Decimal(18, 4)
  commissionPerUnitUsd Decimal       @default(0) @map("commission_per_unit_usd") @db.Decimal(18, 4)
  commissionUsd        Decimal       @default(0) @map("commission_usd") @db.Decimal(18, 4)
  sellerPartyAccountId String?       @map("seller_party_account_id") @db.Uuid
  sellerPartyAccount   PartyAccount? @relation("SalesLineSeller", fields: [sellerPartyAccountId], references: [id])
  onatUsd              Decimal       @default(0) @map("onat_usd") @db.Decimal(18, 4)

  movement InventoryMovement?

  @@index([containerId])
  @@index([sellerPartyAccountId])
  @@map("sales_line")
}

// ───────────────────────── Fase 5: financiamientos, fiscal, capital y cierres ─────────────────────────

enum LoanDirection {
  /// Préstamo que damos (por cobrar, 138).
  GIVEN
  /// Préstamo que recibimos (por pagar, 411; la parte a más de un año, 520).
  RECEIVED
}

enum LoanStatus {
  ACTIVE
  CLOSED
}

/// Financiamiento con interés fijo sobre el principal (como el "Importe + %" del Excel), devengado por días.
model Loan {
  id             String        @id @default(uuid(7)) @db.Uuid
  companyId      String        @map("company_id") @db.Uuid
  company        Company       @relation(fields: [companyId], references: [id])
  partyAccountId String        @map("party_account_id") @db.Uuid
  partyAccount   PartyAccount  @relation(fields: [partyAccountId], references: [id])
  direction      LoanDirection
  reference      String
  description    String
  startDate      DateTime      @map("start_date") @db.Date
  /// Vencimiento; sin él, el interés se devenga entero el mes de inicio.
  endDate        DateTime?     @map("end_date") @db.Date
  principalUsd   Decimal       @map("principal_usd") @db.Decimal(18, 4)
  /// Interés total sobre el principal, en % (no anual): 9 = 9 %.
  ratePct        Decimal       @map("rate_pct") @db.Decimal(9, 4)
  interestUsd    Decimal       @map("interest_usd") @db.Decimal(18, 4)
  /// Parte reclasificada a largo plazo (520) a la fecha de la última reclasificación.
  longTermUsd    Decimal       @default(0) @map("long_term_usd") @db.Decimal(18, 4)
  status         LoanStatus    @default(ACTIVE)
  /// Registrado desde el Excel: el principal y el interés ya están contabilizados (no se devenga).
  migrated       Boolean       @default(false)
  documentId     String?       @unique @map("document_id") @db.Uuid
  document       Document?     @relation("LoanDisbursement", fields: [documentId], references: [id])
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz
  createdBy      String?       @map("created_by") @db.Uuid

  accruals LoanAccrual[]

  @@unique([companyId, reference])
  @@map("loan")
}

/// Interés devengado de un préstamo en un mes (uno por préstamo y mes).
model LoanAccrual {
  id         String   @id @default(uuid(7)) @db.Uuid
  loanId     String   @map("loan_id") @db.Uuid
  loan       Loan     @relation(fields: [loanId], references: [id])
  year       Int
  month      Int
  amountUsd  Decimal  @map("amount_usd") @db.Decimal(18, 4)
  documentId String   @unique @map("document_id") @db.Uuid
  document   Document @relation("LoanAccrual", fields: [documentId], references: [id])

  @@unique([loanId, year, month])
  @@map("loan_accrual")
}

enum TaxAgency {
  /// Cuba (Distribución, 999): cierre trimestral.
  ONAT
  /// España (Exportación, 888): cierre anual.
  HACIENDA
}

enum TaxDocKind {
  ACCRUAL
  ADJUSTMENT
}

/// Devengo de impuestos (gasto contra 480) y cierre del periodo fiscal (diferencia a 848/920).
model TaxDocument {
  id          String     @id @db.Uuid
  document    Document   @relation(fields: [id], references: [id])
  companyId   String     @map("company_id") @db.Uuid
  agency      TaxAgency
  kind        TaxDocKind
  periodFrom  DateTime   @map("period_from") @db.Date
  periodTo    DateTime   @map("period_to") @db.Date
  amountUsd   Decimal    @map("amount_usd") @db.Decimal(18, 4)
  /// Solo en los cierres: lo declarado y lo devengado en el periodo.
  declaredUsd Decimal?   @map("declared_usd") @db.Decimal(18, 4)
  accruedUsd  Decimal?   @map("accrued_usd") @db.Decimal(18, 4)

  @@index([companyId, agency, periodFrom])
  @@map("tax_document")
}

enum CapitalMoveKind {
  CONTRIBUTION
  WITHDRAWAL
  DISTRIBUTION
}

/// Aporte, retiro de capital o reparto de utilidades de un socio.
model CapitalMovement {
  id               String          @id @db.Uuid
  document         Document        @relation(fields: [id], references: [id])
  companyId        String          @map("company_id") @db.Uuid
  partyId          String          @map("party_id") @db.Uuid
  party            Party           @relation(fields: [partyId], references: [id])
  kind             CapitalMoveKind
  amountUsd        Decimal         @map("amount_usd") @db.Decimal(18, 4)
  counterAccountId String          @map("counter_account_id") @db.Uuid
  description      String

  @@index([partyId])
  @@map("capital_movement")
}

/// Cierre anual: resultados del año a Utilidades retenidas (periodo 13). Repetible: anula el anterior.
model YearClose {
  id        String   @id @default(uuid(7)) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  company   Company  @relation(fields: [companyId], references: [id])
  year      Int
  entryIds  String[] @map("entry_ids") @db.Uuid
  resultUsd Decimal  @map("result_usd") @db.Decimal(18, 4)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  createdBy String?  @map("created_by") @db.Uuid

  @@unique([companyId, year])
  @@map("year_close")
}
