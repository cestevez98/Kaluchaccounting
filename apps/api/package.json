{
  "name": "@kaluch/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput & node --env-file-if-exists=../../.env --watch-path=dist dist/main.js",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "test": "dotenv -e ../../.env -- vitest run"
  },
  "dependencies": {
    "@kaluch/db": "workspace:*",
    "@kaluch/shared": "workspace:*",
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/swagger": "11.4.7",
    "argon2": "0.44.0",
    "cookie-parser": "1.4.7",
    "exceljs": "4.4.0",
    "otplib": "12.0.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.7",
    "@swc/core": "1.16.13",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "22.18.8",
    "@types/supertest": "6.0.3",
    "dotenv-cli": "10.0.0",
    "supertest": "7.3.1",
    "unplugin-swc": "1.6.0",
    "vitest": "3.2.4"
  }
}
