# Copia este fichero a docker/.env.prod EN EL SERVIDOR y rellena los valores.
# Nunca subas .env.prod al repositorio. Genera secretos con:  openssl rand -base64 48
DOMAIN=kgtaccounting.com
ACME_EMAIL=kaluchexport@gmail.com

POSTGRES_USER=kaluch
POSTGRES_PASSWORD=CAMBIAR-por-un-secreto-largo
POSTGRES_DB=kaluch

JWT_SECRET=CAMBIAR-por-un-secreto-de-al-menos-48-caracteres

# 2FA obligatorio para los roles que lo exigen (Superadministrador, Contador).
AUTH_ENFORCE_2FA=true
BACKUP_KEEP_DAYS=30
# Días que se conservan las copias en Google Drive (si está configurado).
OFFSITE_KEEP_DAYS=180
