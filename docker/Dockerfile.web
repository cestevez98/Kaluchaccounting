# Imagen de la web (Next.js standalone).
# Construir desde la raíz del repositorio:  docker build -f docker/Dockerfile.web -t kaluch-web .
FROM public.ecr.aws/docker/library/node:22-bookworm-slim AS build
RUN corepack enable
ENV CI=true
WORKDIR /app
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json turbo.json tsconfig.base.json ./
COPY packages/shared ./packages/shared
COPY apps/web ./apps/web
RUN pnpm install --frozen-lockfile --filter @kaluch/web... --filter @kaluch/shared
RUN pnpm --filter @kaluch/shared build && pnpm --filter @kaluch/web build

FROM public.ecr.aws/docker/library/node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends tini && rm -rf /var/lib/apt/lists/*
ENV NODE_ENV=production HOSTNAME=0.0.0.0 PORT=3000
WORKDIR /app
COPY --from=build /app/apps/web/.next/standalone ./
COPY --from=build /app/apps/web/.next/static ./apps/web/.next/static
RUN useradd --system --uid 1001 kaluch && chown -R kaluch /app
USER kaluch
EXPOSE 3000
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["node", "apps/web/server.js"]
